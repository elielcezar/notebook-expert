# Next.js static export - Apache/LiteSpeed config

Options -MultiViews -Indexes
DirectoryIndex index.html

ErrorDocument 404 /404.html

# Roteamento: serve /foo como /foo.html quando o arquivo existe
# Cobre /reparo-de-notebooks, /reparo-de-notebooks/post-x, /compra-venda/produto-y, etc.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A seção /dicas virou /reparo-de-notebooks (mesmos slugs). 301 preserva
  # links antigos e transfere a indexação do Google. Precisa vir antes das
  # regras abaixo.
  RewriteRule ^dicas/?$ /reparo-de-notebooks [R=301,L]
  RewriteRule ^dicas/(.+?)/?$ /reparo-de-notebooks/$1 [R=301,L]

  # Não reescrever requests que batem com arquivos reais (CSS, JS, imagens, _next/...)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Se existe /caminho.html, serve em vez de tentar entrar na pasta /caminho/
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# Garante o tipo certo para AVIF (imagem do topo da home)
AddType image/avif .avif

# Compactação gzip
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/woff font/woff2
</IfModule>

# Cache de assets imutáveis (Next.js usa hash no nome dos arquivos em _next/static)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  # A Hostinger serve .js como application/x-javascript: sem estas linhas os
  # chunks do Next caíam no padrão do servidor (7 dias)
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # HTML não cacheia agressivamente para garantir que conteúdo novo apareça
  ExpiresByType text/html "access plus 1 hour"
</IfModule>

# Forçar revalidação de HTML
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
